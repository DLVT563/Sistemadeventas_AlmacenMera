@model POSVentaMera.Models.Cobranza
@{
    ViewData["Title"] = "Detalle de Cobro";
}

<h1 class="h3 mb-4">Detalle de Cobro</h1>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Contribuyente</dt>
            <dd class="col-sm-9">@Model.Contribuyente?.NombreContribuyente (@Model.Contribuyente?.Ruc)</dd>

            <dt class="col-sm-3">Periodo</dt>
            <dd class="col-sm-9">@Model.Periodo.ToString("MMMM yyyy")</dd>

            <dt class="col-sm-3">Servicio</dt>
            <dd class="col-sm-9">@Model.Servicio</dd>

            <dt class="col-sm-3">Monto</dt>
            <dd class="col-sm-9">@Model.Monto.ToString("C")</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Estado</dd>

            <dt class="col-sm-3">Fecha de pago</dt>
            <dd class="col-sm-9">@(Model.FechaPago?.ToString("d") ?? "-")</dd>

            <dt class="col-sm-3">Recurrente</dt>
            <dd class="col-sm-9">@(Model.EsRecurrente ? "Sí" : "No")</dd>

            <dt class="col-sm-3">Notas</dt>
            <dd class="col-sm-9">@Model.Notas</dd>
        </dl>
    </div>
</div>

<div class="btn-group">
    <a asp-action="Edit" asp-route-id="@Model.IdCobranza" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
